# Copy to .env and fill in inside the ING environment. Never commit .env.
KCT_PROJECT_ID=
KCT_LOCATION=europe-west4
KCT_MODEL=gemini-2.5-pro
KCT_TEMPERATURE=0
KCT_MAX_OUTPUT_TOKENS=8192
# Optional overrides
# KCT_STORAGE_ROOT=/home/jupyter/kct-ai/storage
# KCT_PROMPTS_ROOT=/home/jupyter/kct-ai/prompts
