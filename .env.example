# Copy to .env and fill in inside the ING environment. Never commit .env.

# Which AI provider the agents use: gemini | anthropic | fake | replay
KCT_AI_PROVIDER=gemini
# replay = answers recorded earlier from a real provider (demos without network or cost).
# Record: KCT_AI_PROVIDER=gemini and KCT_AI_RECORD=demo. Replay: KCT_AI_PROVIDER=replay and KCT_AI_REPLAY=demo.
# KCT_AI_RECORD=
# KCT_AI_REPLAY=demo
# Model for that provider. Empty = default (gemini-2.5-pro / claude-opus-5-5 / fake)
KCT_AI_MODEL=
KCT_TEMPERATURE=0

# Output token limits. Thinking tokens count against these on Gemini 2.5 and Claude.
KCT_SUMMARY_MAX_TOKENS=16384
KCT_STEPS_MAX_TOKENS=32768
# Assessment: per evidence part, and the final verdict call
KCT_ASSESSMENT_MAX_TOKENS=32768
KCT_VERDICT_MAX_TOKENS=32768

# Prices per million tokens, to show the cost of each assessment. Take them from the Vertex AI
# pricing page for your model and region; 0 shows tokens only.
KCT_PRICE_INPUT_PER_MTOK=0
KCT_PRICE_OUTPUT_PER_MTOK=0
KCT_PRICE_CURRENCY=USD

# Google Cloud project, used by Gemini and by Claude on Vertex AI
KCT_PROJECT_ID=
KCT_LOCATION=europe-west4

# Claude: "vertex" (Claude on Vertex AI, uses KCT_PROJECT_ID) or "api" (uses ANTHROPIC_API_KEY)
KCT_ANTHROPIC_PLATFORM=vertex
KCT_ANTHROPIC_REGION=europe-west1
# ANTHROPIC_API_KEY=

# Uploads and outputs: local (under KCT_STORAGE_ROOT) | gcs
KCT_FILES_DRIVER=local
# For gcs: bucket name, and optionally a folder inside it
KCT_GCS_BUCKET=
KCT_GCS_PREFIX=

# Database: memory | sqlite (storage/database.sqlite) | bigquery
# memory stores nothing: results live until the API or notebook kernel restarts.
# Keep it until a database is approved.
KCT_DB_DRIVER=memory
# KCT_DB_PATH=/home/jupyter/kct-ai/storage/database.sqlite
# For bigquery: dataset name (in KCT_PROJECT_ID) or project.dataset, and its location
KCT_BQ_DATASET=
KCT_BQ_LOCATION=

# Evidence documents (assessment), one folder per case: <root>/case-001/...
# Default: storage/evidences
# KCT_EVIDENCES_ROOT=/home/jupyter/kct-ai/storage/evidences

# Control folders (SharePoint structure, OneDrive-synced or downloaded) the API may import from:
# POST /cases/import only accepts paths inside this folder. Notebooks may import from anywhere.
# KCT_IMPORT_ROOT=/home/jupyter/sharepoint

# Uploaded ZIPs (POST /cases/import-zip): limits for the unpacked content
KCT_ZIP_MAX_MB=2048
KCT_ZIP_MAX_FILES=5000

# Evidence is split into parts before it goes to the model, when a PDF has more pages or MB
# than below, or a part would be estimated above KCT_EVIDENCE_MAX_TOKENS.
KCT_PDF_MAX_PAGES=50
KCT_PDF_MAX_MB=20
KCT_PDF_OVERLAP_PAGES=2
KCT_EVIDENCE_MAX_TOKENS=300000

# Brand on the report and dashboard. The logo file comes from ING's brand portal and is never
# committed (public repository). Default place: branding/logo.png
# KCT_BRAND_LOGO=/home/jupyter/kct-ai/branding/logo.png
# KCT_BRAND_NAME=ING

# Optional overrides
# KCT_STORAGE_ROOT=/home/jupyter/kct-ai/storage
# KCT_PROMPTS_ROOT=/home/jupyter/kct-ai/prompts
# KCT_FIXTURES_ROOT=/home/jupyter/kct-ai/tests/fixtures/fake_ai

# Docker only: ports on this machine for the API and JupyterLab
# KCT_API_PORT=8000
# KCT_JUPYTER_PORT=8888
